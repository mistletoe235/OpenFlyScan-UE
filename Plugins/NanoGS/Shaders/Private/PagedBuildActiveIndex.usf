// Expand one compact descriptor per active Page v1 page into the exact
// active->physical index stream consumed by CalcViewData.

#include "/Engine/Public/Platform.ush"

#ifndef THREADGROUP_SIZE
#define THREADGROUP_SIZE 256
#endif

StructuredBuffer<uint4> PageDescriptors;
RWStructuredBuffer<uint> ActivePhysicalIndices;
uint PageCount;

[numthreads(THREADGROUP_SIZE, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID)
{
	const uint PageIndex = GroupId.x;
	if (PageIndex >= PageCount)
	{
		return;
	}

	const uint4 Descriptor = PageDescriptors[PageIndex];
	const uint ActiveBase = Descriptor.x;
	const uint PhysicalBase = Descriptor.y;
	const uint SplatCount = Descriptor.z;
	for (uint LocalIndex = GroupThreadId.x; LocalIndex < SplatCount; LocalIndex += THREADGROUP_SIZE)
	{
		ActivePhysicalIndices[ActiveBase + LocalIndex] = (PhysicalBase + LocalIndex) | Descriptor.w;
	}
}
